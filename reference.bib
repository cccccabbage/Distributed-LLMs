	keywords = {AI, LLM, Distributed Learning},
	pages = {586--602},
	file = {PDF:C\:\\Users\\ccccc\\Zotero\\storage\\TNWQCXS3\\Mei 等 - 2025 - Helix Serving Large Language Models over Heterogeneous GPUs and Network via Max-Flow.pdf:application/pdf},
